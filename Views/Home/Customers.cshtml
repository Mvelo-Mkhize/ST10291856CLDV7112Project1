@model List<CustomerProfile>
@inject BlobStorageService BlobService
@{
    ViewData["Title"] = "Customers";
}

<h2>All Customers</h2>

<div class="mb-2 d-flex gap-2">
    <a asp-action="Index" class="btn btn-outline-secondary">Back to Home</a>
    <a asp-action="Products" class="btn btn-outline-secondary">Products</a>
    <a asp-action="Images" class="btn btn-outline-secondary">Images</a>
    <a asp-action="Queues" class="btn btn-outline-secondary">Queue</a>
    <a asp-action="Logs" class="btn btn-outline-secondary">Logs</a>
</div>

<table class="table table-striped align-middle">
    <thead>
        <tr><th>Image</th><th>Email</th><th>First</th><th>Last</th><th>Phone</th></tr>
    </thead>
    <tbody>
        @foreach (var c in Model)
        {
            <tr>
                <td>
                    @if (!string.IsNullOrEmpty(c.ImageBlobName))
                    {
                        <img src="@BlobService.GetBlobUrl(c.ImageBlobName)"
                             style="width:50px;height:50px;object-fit:cover;border-radius:50%;" />
                    }
                </td>
                <td>@c.RowKey</td>
                <td>@c.FirstName</td>
                <td>@c.LastName</td>
                <td>@c.Phone</td>
            </tr>
        }
    </tbody>
</table>