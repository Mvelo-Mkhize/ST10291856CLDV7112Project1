@model List<CustomerProfile>
@inject BlobStorageService BlobService

<h2>All Customers</h2>
<table>
    <tr>
        <th>Image</th>
        <th>Email</th>
        <th>First Name</th>
        <th>Last Name</th>
        <th>Phone</th>
    </tr>
    @foreach (var c in Model)
    {
        <tr>
            <td>
                @if (!string.IsNullOrEmpty(c.ImageBlobName))
                {
                    <img src="@BlobService.GetBlobUrl(c.ImageBlobName)" alt="Customer Image" style="width:50px; height:50px; object-fit:cover; border-radius:50%;" />
                }
                else
                {
                    <img src="data:image/svg+xml;charset=UTF-8,%3Csvg xmlns='http://www.w3.org/2000/svg' width='50' height='50' viewBox='0 0 50 50'%3E%3Crect width='50' height='50' fill='%23dddddd'/%3E%3Ctext x='50%25' y='50%25' dominant-baseline='middle' text-anchor='middle' font-size='20' fill='%23999999'%3E👤%3C/text%3E%3C/svg%3E" alt="No Image" style="width:50px; height:50px;" />
                }
            </td>
            <td>@c.RowKey</td>
            <td>@c.FirstName</td>
            <td>@c.LastName</td>
            <td>@c.Phone</td>
        </tr>
    }
</table>