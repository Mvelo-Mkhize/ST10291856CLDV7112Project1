@model DashboardViewModel
@inject BlobStorageService BlobService
@{
    ViewData["Title"] = "ABC Retail Dashboard";
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<h2 class="mb-3">ABC Retail — Product Catalogue</h2>
<div asp-validation-summary="All" class="text-danger"></div>

@if (!Model.Products.Any())
{
    <p class="text-muted">No products yet — add one below.</p>
}
else
{
    <table class="table table-striped align-middle">
        <thead>
            <tr>
                <th>Image</th>
                <th>SKU</th>
                <th>Name</th>
                <th>Description</th>
                <th>Price</th>
                <th>Stock</th>
                <th>Order</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var p in Model.Products)
            {
                <tr>
                    <td>
                        @if (!string.IsNullOrEmpty(p.ImageBlobName))
                        {
                            <img src="@BlobService.GetBlobUrl(p.ImageBlobName)"
                                 alt="@p.Name" style="width:60px;height:60px;object-fit:cover;" />
                        }
                        else
                        {
                            <span class="text-muted small">No image</span>
                        }
                    </td>
                    <td>@p.RowKey</td>
                    <td>@p.Name</td>
                    <td style="white-space: pre-line;">@p.Description</td>
                    <td>@p.Price.ToString("C")</td>
                    <td>@p.StockQuantity</td>
                    <td>
                        <form asp-action="ProcessOrder" method="post" class="d-flex gap-1">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="sku" value="@p.RowKey" />
                            <input type="number" name="quantity" value="1" min="1"
                                   max="@p.StockQuantity" class="form-control form-control-sm"
                                   style="width:70px;" />
                            <button type="submit" class="btn btn-sm btn-primary">Order</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

<hr />

<div class="row g-3">
    <div class="col-md-6">
        <div class="card p-3">
            <h4>Add Customer</h4>
            <form asp-action="AddCustomer" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <div class="mb-2">
                    <label asp-for="Customer.FirstName"></label>
                    <input asp-for="Customer.FirstName" class="form-control" />
                    <span asp-validation-for="Customer.FirstName" class="text-danger"></span>
                </div>
                <div class="mb-2">
                    <label asp-for="Customer.LastName"></label>
                    <input asp-for="Customer.LastName" class="form-control" />
                    <span asp-validation-for="Customer.LastName" class="text-danger"></span>
                </div>
                <div class="mb-2">
                    <label asp-for="Customer.Email"></label>
                    <input asp-for="Customer.Email" class="form-control" type="email" />
                    <span asp-validation-for="Customer.Email" class="text-danger"></span>
                </div>
                <div class="mb-2">
                    <label asp-for="Customer.Phone"></label>
                    <input asp-for="Customer.Phone" class="form-control" />
                    <span asp-validation-for="Customer.Phone" class="text-danger"></span>
                </div>
                <div class="mb-2">
                    <label for="customerImage">Profile Image (optional)</label>
                    <input type="file" name="customerImage" accept="image/*" class="form-control" />
                </div>
                <button type="submit" class="btn btn-primary">Add Customer</button>
                <a asp-action="Customers" class="btn btn-outline-secondary">View Customers</a>
            </form>
        </div>
    </div>

    <div class="col-md-6">
        <div class="card p-3">
            <h4>Add Product</h4>
            <form asp-action="AddProduct" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <div class="mb-2">
                    <label asp-for="Product.RowKey">SKU</label>
                    <input asp-for="Product.RowKey" class="form-control" />
                    <span asp-validation-for="Product.RowKey" class="text-danger"></span>
                </div>
                <div class="mb-2">
                    <label asp-for="Product.Name"></label>
                    <input asp-for="Product.Name" class="form-control" />
                    <span asp-validation-for="Product.Name" class="text-danger"></span>
                </div>
                <div class="mb-2">
                    <label asp-for="Product.Description"></label>
                    <textarea asp-for="Product.Description" rows="3" class="form-control"></textarea>
                </div>
                <div class="mb-2">
                    <label asp-for="Product.Price"></label>
                    <input asp-for="Product.Price" type="number" step="0.01" class="form-control" />
                    <span asp-validation-for="Product.Price" class="text-danger"></span>
                </div>
                <div class="mb-2">
                    <label asp-for="Product.StockQuantity"></label>
                    <input asp-for="Product.StockQuantity" type="number" class="form-control" />
                    <span asp-validation-for="Product.StockQuantity" class="text-danger"></span>
                </div>
                <div class="mb-2">
                    <label for="productImage">Product Image (optional)</label>
                    <input type="file" name="productImage" accept="image/*" class="form-control" />
                </div>
                <button type="submit" class="btn btn-primary">Add Product</button>
                <a asp-action="Products" class="btn btn-outline-secondary">View Products</a>
            </form>
        </div>
    </div>

    <div class="col-md-6">
        <div class="card p-3">
            <h4>Upload Image (Blob)</h4>
            <form asp-action="UploadImage" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <div class="mb-2">
                    <input type="file" name="imageFile" accept="image/*" class="form-control" required />
                </div>
                <button type="submit" class="btn btn-primary">Upload</button>
                <a asp-action="Images" class="btn btn-outline-secondary">View Images</a>
            </form>
        </div>
    </div>

    <div class="col-md-6">
        <div class="card p-3">
            <h4>Order Processing Queue</h4>
            <p class="text-muted small">
                Use the <strong>Order</strong> button in the product table above,
                or place a manual order here:
            </p>
            <form asp-action="ProcessOrder" method="post" class="row g-2">
                @Html.AntiForgeryToken()
                <div class="col-5">
                    <input name="sku" class="form-control" placeholder="SKU" required />
                </div>
                <div class="col-4">
                    <input name="quantity" type="number" min="1" value="1" class="form-control" required />
                </div>
                <div class="col-3">
                    <button class="btn btn-primary w-100" type="submit">Place</button>
                </div>
            </form>
            <div class="mt-2">
                <a asp-action="Queues" class="btn btn-outline-secondary">View Queue</a>
            </div>
        </div>
    </div>

    <div class="col-12">
        <div class="card p-3">
            <h4>Log Files (Azure Files)</h4>
            <p class="text-muted small">
                Logs are written <strong>automatically</strong> on every action (customer,
                product, order, upload, queue). You can also add a manual entry below.
            </p>
            <form asp-action="WriteLog" method="post" class="row g-2">
                @Html.AntiForgeryToken()
                <div class="col-md-4">
                    <input name="logFileName" class="form-control"
                           placeholder="log-YYYY-MM-DD.log (optional)" />
                </div>
                <div class="col-md-6">
                    <input name="logMessage" class="form-control"
                           placeholder="Log message" required />
                </div>
                <div class="col-md-2">
                    <button class="btn btn-primary w-100" type="submit">Write</button>
                </div>
            </form>
            <div class="mt-2">
                <a asp-action="Logs" class="btn btn-outline-secondary">View Logs</a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}