@model DashboardViewModel
@{
    ViewData["Title"] = "Azure Storage Demo";
}
<h2>ABC Retail - Azure Storage Management</h2>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div asp-validation-summary="All" class="text-danger"></div>

<div class="card">
    <h3>Customer Profile</h3>
    <form asp-action="AddCustomer" method="post" enctype="multipart/form-data">
        <div>
            <label asp-for="Customer.FirstName"></label>
            <input asp-for="Customer.FirstName" placeholder="First Name" />
            <span asp-validation-for="Customer.FirstName" class="text-danger"></span>
        </div>
        <div>
            <label asp-for="Customer.LastName"></label>
            <input asp-for="Customer.LastName" placeholder="Last Name" />
            <span asp-validation-for="Customer.LastName" class="text-danger"></span>
        </div>
        <div>
            <label asp-for="Customer.Email"></label>
            <input asp-for="Customer.Email" placeholder="Email" type="email" />
            <span asp-validation-for="Customer.Email" class="text-danger"></span>
        </div>
        <div>
            <label asp-for="Customer.Phone"></label>
            <input asp-for="Customer.Phone" placeholder="Phone" />
            <span asp-validation-for="Customer.Phone" class="text-danger"></span>
        </div>
        <div>
            <label for="customerImage">Profile Image (optional)</label>
            <input type="file" name="customerImage" accept="image/*" />
        </div>
        <button type="submit">Add Customer</button>
    </form>
    <a asp-action="Customers">View All Customers</a>
</div>

<div class="card">
    <h3>Product</h3>
    <form asp-action="AddProduct" method="post" enctype="multipart/form-data">
        <div>
            <label asp-for="Product.RowKey"></label>
            <input asp-for="Product.RowKey" placeholder="SKU" />
            <span asp-validation-for="Product.RowKey" class="text-danger"></span>
        </div>
        <div>
            <label asp-for="Product.Name"></label>
            <input asp-for="Product.Name" placeholder="Product Name" />
            <span asp-validation-for="Product.Name" class="text-danger"></span>
        </div>
        <div>
            <label asp-for="Product.Description"></label>
            <textarea asp-for="Product.Description" rows="3" placeholder="Enter description with line breaks (Shift+Enter for soft break)"></textarea>
            <span asp-validation-for="Product.Description" class="text-danger"></span>
        </div>
        <div>
            <label asp-for="Product.Price"></label>
            <input asp-for="Product.Price" placeholder="Price" type="number" step="0.01" />
            <span asp-validation-for="Product.Price" class="text-danger"></span>
        </div>
        <div>
            <label asp-for="Product.StockQuantity"></label>
            <input asp-for="Product.StockQuantity" placeholder="Stock Qty" type="number" />
            <span asp-validation-for="Product.StockQuantity" class="text-danger"></span>
        </div>
        <div>
            <label for="productImage">Product Image (optional)</label>
            <input type="file" name="productImage" accept="image/*" />
        </div>
        <button type="submit">Add Product</button>
    </form>
    <a asp-action="Products">View All Products</a>
</div>

<div class="card">
    <h3>Image Upload</h3>
    <form asp-action="UploadImage" method="post" enctype="multipart/form-data">
        <div>
            <label for="imageFile">Choose Image</label>
            <input id="imageFile" type="file" name="imageFile" accept="image/*" />
        </div>
        <button type="submit">Upload Image</button>
    </form>
    <a asp-action="Images">View Uploaded Images</a>
</div>

<div class="card">
    <h3>Order Processing Queue</h3>
    <form asp-action="ProcessOrder" method="post">
        <div>
            <label for="sku">SKU</label>
            <input id="sku" name="sku" placeholder="Enter SKU" required />
        </div>
        <div>
            <label for="quantity">Quantity</label>
            <input id="quantity" name="quantity" type="number" min="1" placeholder="Quantity" required />
        </div>
        <button type="submit">Place Order</button>
    </form>
    <a asp-action="Queues">View Order Queue</a>
</div>

<div class="card">
    <h3>Log Files</h3>
    <form asp-action="WriteLog" method="post">
        <div>
            <label for="logFileName">Log File Name</label>
            <input id="logFileName" name="logFileName" placeholder="e.g., errors.log" />
        </div>
        <div>
            <label for="logMessage">Log Message</label>
            <input id="logMessage" name="logMessage" placeholder="Log message" />
        </div>
        <button type="submit">Write Log</button>
    </form>
    <a asp-action="Logs">View Log Files</a>
</div>