@model List<string>
@inject BlobStorageService BlobService
@{
    ViewData["Title"] = "Images";
}

<h2>Uploaded Images</h2>

<div class="mb-2 d-flex gap-2">
    <a asp-action="Index" class="btn btn-outline-secondary">Back to Home</a>
    <a asp-action="Products" class="btn btn-outline-secondary">Products</a>
    <a asp-action="Customers" class="btn btn-outline-secondary">Customers</a>
    <a asp-action="Queues" class="btn btn-outline-secondary">Queue</a>
    <a asp-action="Logs" class="btn btn-outline-secondary">Logs</a>
</div>

@if (!Model.Any())
{
    <p>No images uploaded.</p>
}
else
{
    <div class="row g-3">
        @foreach (var blob in Model)
        {
            <div class="col-md-3">
                <div class="card p-2">
                    <img src="@BlobService.GetBlobUrl(blob)" style="width:100%;height:160px;object-fit:cover;" />
                    <p class="small text-truncate mt-2 mb-1" title="@blob">@blob</p>
                    <a asp-action="DownloadImage" asp-route-blobName="@blob"
                       class="btn btn-sm btn-outline-primary">Download</a>
                </div>
            </div>
        }
    </div>
}