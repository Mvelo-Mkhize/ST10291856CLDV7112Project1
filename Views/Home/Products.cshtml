@model List<Product>
@inject BlobStorageService BlobService
@{
    ViewData["Title"] = "Products";
}

<h2>All Products</h2>

<div class="mb-2 d-flex gap-2">
    <a asp-action="Index" class="btn btn-outline-secondary">Back to Home</a>
    <a asp-action="Customers" class="btn btn-outline-secondary">Customers</a>
    <a asp-action="Images" class="btn btn-outline-secondary">Images</a>
    <a asp-action="Queues" class="btn btn-outline-secondary">Queue</a>
    <a asp-action="Logs" class="btn btn-outline-secondary">Logs</a>
</div>

<table class="table table-striped align-middle">
    <thead>
        <tr><th>Image</th><th>SKU</th><th>Name</th><th>Description</th><th>Price</th><th>Stock</th><th>Order</th></tr>
    </thead>
    <tbody>
        @foreach (var p in Model)
        {
            <tr>
                <td>
                    @if (!string.IsNullOrEmpty(p.ImageBlobName))
                    {
                        <img src="@BlobService.GetBlobUrl(p.ImageBlobName)" style="width:60px;height:60px;object-fit:cover;" />
                    }
                </td>
                <td>@p.RowKey</td>
                <td>@p.Name</td>
                <td style="white-space: pre-line;">@p.Description</td>
                <td>@p.Price.ToString("C")</td>
                <td>@p.StockQuantity</td>
                <td>
                    <form asp-action="ProcessOrder" method="post" class="d-flex gap-1">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="sku" value="@p.RowKey" />
                        <input type="number" name="quantity" value="1" min="1" max="@p.StockQuantity"
                               class="form-control form-control-sm" style="width:70px;" />
                        <button type="submit" class="btn btn-sm btn-primary">Order</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>