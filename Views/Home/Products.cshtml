@model List<Product>
@inject BlobStorageService BlobService

<h2>All Products</h2>
<table>
    <tr>
        <th>Image</th>
        <th>SKU</th>
        <th>Name</th>
        <th>Description</th>
        <th>Price</th>
        <th>Stock</th>
    </tr>
    @foreach (var p in Model)
    {
        <tr>
            <td>
                @if (!string.IsNullOrEmpty(p.ImageBlobName))
                {
                    <img src="@BlobService.GetBlobUrl(p.ImageBlobName)" alt="Product Image" style="width:50px; height:50px; object-fit:cover;" />
                }
                else
                {
                    <img src="data:image/svg+xml;charset=UTF-8,%3Csvg xmlns='http://www.w3.org/2000/svg' width='50' height='50' viewBox='0 0 50 50'%3E%3Crect width='50' height='50' fill='%23dddddd'/%3E%3Ctext x='50%25' y='50%25' dominant-baseline='middle' text-anchor='middle' font-size='20' fill='%23999999'%3E📦%3C/text%3E%3C/svg%3E" alt="No Image" style="width:50px; height:50px;" />
                }
            </td>
            <td>@p.RowKey</td>
            <td>@p.Name</td>
            <td style="white-space: pre-line;">@p.Description</td>
            <td>@p.Price.ToString("C")</td>
            <td>@p.StockQuantity</td>
        </tr>
    }
</table>