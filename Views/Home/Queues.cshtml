@model List<QueueMessageViewModel>
@inject BlobStorageService BlobService
@{
    ViewData["Title"] = "Order Queue";
    int count = ViewBag.QueueCount ?? 0;
}

<h2>Order Queue <span class="badge bg-info text-dark">@count message(s)</span></h2>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">@TempData["SuccessMessage"]</div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
}

<div class="mb-3 d-flex gap-2 flex-wrap">
    <form asp-action="ProcessNextOrder" method="post">
        @Html.AntiForgeryToken()
        <button class="btn btn-success">Process Next Order</button>
    </form>
    <form asp-action="ClearQueue" method="post"
          onsubmit="return confirm('Clear all queue messages?');">
        @Html.AntiForgeryToken()
        <button class="btn btn-danger">Clear Queue</button>
    </form>
    <a asp-action="Index" class="btn btn-outline-secondary">Back to Home</a>
    <a asp-action="Products" class="btn btn-outline-secondary">Products</a>
    <a asp-action="Logs" class="btn btn-outline-secondary">Logs</a>
</div>

@if (!Model.Any())
{
    <p>No messages in queue.</p>
}
else
{
    <table class="table table-striped align-middle">
        <thead><tr><th>Image</th><th>SKU</th><th>Product</th><th>Qty</th><th>Order ID</th></tr></thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>
                        @if (!string.IsNullOrEmpty(item.ImageBlobName))
                        {
                            <img src="@BlobService.GetBlobUrl(item.ImageBlobName)"
                                 style="width:50px;height:50px;object-fit:cover;" />
                        }
                    </td>
                    <td>@item.SKU</td>
                    <td>@item.ProductName</td>
                    <td>@item.Quantity</td>
                    <td class="small">@item.OrderId</td>
                </tr>
            }
        </tbody>
    </table>
}